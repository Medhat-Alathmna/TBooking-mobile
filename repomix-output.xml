<ion-content mode="ios" class="ion-padding">
  <ion-header>
    <ion-toolbar mode="ios" >
      <ion-buttons slot="start">
        <ion-button (click)="dismissModal()">Back <ion-icon name="chevron-back-outline" slot="start"></ion-icon>
        </ion-button>
      </ion-buttons>
      <!-- <ion-title>{{updateMode?product.name:'Product'}}</ion-title> -->
      <ion-buttons slot="end">
        <ion-button *ngIf="permissionService.hasPermission('Products', 'update')&&updateMode" (click)="updateProduct()" [disabled]="form.invalid" color="primary">
